---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

import favicon from "@/assets/favicon.png";
import defaultOgImage from "@/assets/logo.png";
import Analytics from "@/components/Analytics.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  pageType?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
  previousPagePath?: string;
  nextPagePath?: string;
}

const siteName = "Kangetsu Blog";
const {
  title,
  description = "Kangetsu Blog",
  ogImage = defaultOgImage,
  ogImageAlt = siteName,
  pageType = "website",
  publishedAt,
  updatedAt,
  noindex = false,
  previousPagePath,
  nextPagePath,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteName}` : siteName;
const siteURL = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const optimizedOgImage =
  pageType === "article"
    ? await getImage({
        src: ogImage,
        width: Math.min(ogImage.width, 1200),
        format: "png",
        quality: "mid",
      })
    : undefined;

const ogImageURL = new URL(optimizedOgImage?.src ?? ogImage.src, siteURL).href;

const articleStructuredData =
  pageType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title ?? siteName,
        description,
        image: ogImageURL,
        url: canonicalURL.href,
        datePublished: publishedAt?.toISOString(),
        dateModified: (updatedAt ?? publishedAt)?.toISOString(),
        inLanguage: "ja-JP",
      }
    : undefined;

const articleStructuredDataJson = articleStructuredData
  ? JSON.stringify(articleStructuredData).replaceAll("<", "\\u003c")
  : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <Analytics />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description}>

    <link rel="canonical" href={canonicalURL}>
    {previousPagePath && (
      <link
        rel="prev"
        href={new URL(previousPagePath, siteURL)}
      />
    )}
    {nextPagePath && (
      <link
        rel="next"
        href={new URL(nextPagePath, siteURL)}
      />
    )}
    <link rel="icon" type="image/png" href={favicon.src}>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kangetsu Blog"
      href={new URL("/rss.xml", siteURL)}
    >
    <link rel="sitemap" href="/sitemap-index.xml">

    <meta property="og:site_name" content={siteName}>
    <meta property="og:locale" content="ja_JP">
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content={pageType}>
    {pageType === "article" && publishedAt && (
      <meta
        property="article:published_time"
        content={publishedAt.toISOString()}
      />
    )}
    {pageType === "article" && updatedAt && (
      <meta
        property="article:modified_time"
        content={updatedAt.toISOString()}
      />
    )}
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:image" content={ogImageURL}>
    <meta property="og:image:alt" content={ogImageAlt}>

    <meta name="twitter:card" content="summary">
    <meta name="twitter:image" content={ogImageURL}>
    <meta name="twitter:image:alt" content={ogImageAlt}>
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={description}>

    {articleStructuredDataJson && (
    <script
      is:inline
      type="application/ld+json"
      set:html={articleStructuredDataJson}
    />
  )}
  </head>

  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>

    <Header />

    <div id="main-content" class="site-content" tabindex="-1">
      <slot />
    </div>

    <Footer />
  </body>
</html>

<style>
.skip-link {
  position: fixed;
  inset-block-start: 1rem;
  inset-inline-start: 1rem;
  z-index: 1000;
  padding: 0.75rem 1rem;
  color: white;
  background: black;
  transform: translateY(-200%);
}

.skip-link:focus {
  transform: translateY(0);
}

.site-content {
  flex: 1;
  width: min(100% - 2rem, var(--content-width));
  min-width: 0;
  max-width: 100%;
  margin-inline: auto;
}
</style>
